{
  "name": "tabby-ai-tools",
  "version": "0.2.3",
  "description": "A persistent AI agent sidebar for Tabby with Codex, OpenAI, DeepSeek, GLM, and Claude support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hanlen/tabby-ai-tools.git"
  },
  "homepage": "https://github.com/Hanlen/tabby-ai-tools#readme",
  "bugs": {
    "url": "https://github.com/Hanlen/tabby-ai-tools/issues"
  },
  "author": "tabby-ai contributors",
  "license": "MIT",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "ai",
    "assistant",
    "agent",
    "codex",
    "openai",
    "deepseek",
    "glm",
    "claude"
  ],
  "main": "dist/index.js",
  "scripts": {
    "skill:bundle": "node scripts/bundle-tabby-skill.mjs",
    "skill:check": "node scripts/bundle-tabby-skill.mjs --check",
    "skill:update": "node scripts/update-tabby-knowledge.mjs",
    "prebuild": "npm run skill:bundle",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.cjs",
    "smoke:codex": "node scripts/smoke-codex.cjs",
    "smoke:context": "node scripts/smoke-context.cjs",
    "prepack": "npm run build",
    "install:tabby": "node scripts/install-local.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "skills",
    "VALIDATION.md"
  ],
  "devDependencies": {
    "@angular/common": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^18.19.0",
    "apply-loader": "^2.0.0",
    "pug": "^2.0.4",
    "pug-loader": "^2.4.0",
    "rxjs": "^7.8.2",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-settings": "^1.0.231-nightly.0",
    "tabby-terminal": "^1.0.231-nightly.0",
    "ts-loader": "^9.5.4",
    "typescript": "^4.9.5",
    "webpack": "^5.102.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  }
}
