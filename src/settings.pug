.agent-settings([attr.dir]='direction', [attr.lang]='languageCode')
  .settings-heading
    div
      h3 AI Tools
      p.settings-muted {{t("管理你的 AI 连接，选择一个连接开始配置。")}}
    button.btn.btn-primary.settings-add(type='button', (click)='addProfile()') {{t("+ 添加 API 连接")}}
  .settings-default
    .settings-default-label
      label(for='agent-default-profile') {{t("默认连接")}}
      span.settings-muted {{t("新面板使用此连接")}}
    select#agent-default-profile.form-control([(ngModel)]='settings.defaultProfileId', (ngModelChange)='save()')
      option(value='') {{t("Codex（本机登录）")}}
      option(value='claude-code') {{t("Claude Code（本机登录）")}}
      option(*ngFor='let profile of profiles; trackBy: trackProfile', [value]='profile.id') {{profile.name || t("未命名连接")}} · {{t(providerNames[profile.provider])}}
  .settings-default
    .settings-default-label
      label(for='agent-open-on-startup') {{t("启动 Tabby 时自动打开 AI Tools")}}
      span#agent-open-on-startup-hint.settings-muted {{t("保存后，下次启动时生效")}}
    input#agent-open-on-startup(type='checkbox', [(ngModel)]='settings.openOnStartup', (ngModelChange)='save()', aria-describedby='agent-open-on-startup-hint')
  .settings-default
    .settings-default-label
      label(for='agent-language') {{t("界面语言")}}
      span#agent-language-hint.settings-muted {{t("缺少翻译时使用英语；不翻译消息和终端输出。")}}
    select#agent-language.form-control([ngModel]='settings.language || "auto"', (ngModelChange)='settings.language = $event; save()', aria-describedby='agent-language-hint')
      option(value='auto') {{t("跟随 Tabby")}}
      option(*ngFor='let language of languages', [value]='language.code', [attr.lang]='language.code') {{language.name}}
  p.settings-notice(role='status', *ngIf='notice') {{t(notice)}}
  .settings-workspace
    nav.connection-nav([attr.aria-label]='t("AI 连接列表")')
      .connection-nav-heading
        strong {{t("连接")}}
        span.settings-count {{profiles.length + 2}}
      .connection-list
        button.connection-item(type='button', *ngFor='let profile of profiles; trackBy: trackProfile', (click)='selectProfile(profile.id)', [class.connection-selected]='!memoryOpen && !schedulesOpen && selectedProfileId === profile.id', [attr.aria-pressed]='!memoryOpen && !schedulesOpen && selectedProfileId === profile.id', [attr.data-provider]='profile.provider', aria-controls='agent-connection-editor')
          span.provider-mark(aria-hidden='true') {{providerNames[profile.provider].slice(0, 1)}}
          span.connection-info
            span.connection-name-row
              span.connection-name {{profile.name || t("未命名连接")}}
              span.default-badge(*ngIf='settings.defaultProfileId === profile.id') {{t("默认")}}
            span.connection-provider {{t(providerNames[profile.provider])}}
            span.connection-model([title]='profile.model') {{profile.model || t("未设置模型")}}
        button.connection-item.connection-local(type='button', (click)='selectProfile("")', [class.connection-selected]='!memoryOpen && !schedulesOpen && !selectedProfile && !claudeCodeSelected', [attr.aria-pressed]='!memoryOpen && !schedulesOpen && !selectedProfile && !claudeCodeSelected', data-provider='codex', aria-controls='agent-connection-editor')
          span.provider-mark(aria-hidden='true') C
          span.connection-info
            span.connection-name-row
              span.connection-name Codex
              span.default-badge(*ngIf='!settings.defaultProfileId') {{t("默认")}}
            span.connection-provider {{t("本机引擎")}}
            span.connection-model {{t("本机登录 · CLI")}}
        button.connection-item.connection-local(type='button', (click)='selectProfile("claude-code")', [class.connection-selected]='!memoryOpen && !schedulesOpen && claudeCodeSelected', [attr.aria-pressed]='!memoryOpen && !schedulesOpen && claudeCodeSelected', data-provider='claude', aria-controls='agent-connection-editor')
          span.provider-mark(aria-hidden='true') C
          span.connection-info
            span.connection-name-row
              span.connection-name Claude Code
              span.default-badge(*ngIf='settings.defaultProfileId === "claude-code"') {{t("默认")}}
            span.connection-provider {{t("本机引擎")}}
            span.connection-model {{t("本机登录 · CLI")}}
      button.connection-item.connection-memory(type='button', (click)='openMemory()', [class.connection-selected]='memoryOpen', [attr.aria-pressed]='memoryOpen', data-provider='memory', aria-controls='agent-connection-editor')
        span.provider-mark(aria-hidden='true') M
        span.connection-info
          span.connection-name {{t("任务流程与偏好")}}
          span.connection-provider {{t("归档 · 复用 · 操作习惯")}}
      button.connection-item.connection-memory(type='button', (click)='openSchedules()', [class.connection-selected]='schedulesOpen', [attr.aria-pressed]='schedulesOpen', data-provider='schedules', aria-controls='agent-connection-editor')
        span.provider-mark(aria-hidden='true') T
        span.connection-info
          span.connection-name {{t("定时任务")}}
          span.connection-provider {{t("后台执行 · 计划与删除")}}
      p.connection-nav-hint.settings-muted {{t("点击项目切换配置")}}
    section#agent-connection-editor.settings-editor([attr.data-provider]='schedulesOpen ? "schedules" : memoryOpen ? "memory" : selectedProfile?.provider || (claudeCodeSelected ? "claude" : "codex")', [attr.aria-label]='t("AI Tools 配置")')
      ng-container(*ngIf='schedulesOpen')
        .editor-heading
          span.provider-mark(aria-hidden='true') T
          .editor-identity
            .editor-eyebrow {{t("本地计划 · {0} 个任务", [(scheduleData.tasks.length)])}}
            h4 {{t("定时任务")}}
            .editor-model.settings-muted {{t("无人值守运行 · 重启自动加载")}}
          button.btn.btn-outline-secondary.editor-default(type='button', (click)='refreshSchedules()', [disabled]='scheduleLoading || scheduleSaving') {{t("刷新")}}
        .editor-body.schedule-manager
          p.settings-muted {{t("通过 AI 对话创建任务。这里显示所有工作目录的计划；Tabby 打开时执行，关闭期间错过的触发在重启后合并执行一次。运行中被退出打断的任务暂停待检查。")}}
          p.settings-muted {{t("定时会话不询问审批，保留任务沙箱范围；遇到提问会结合任务目标查找信息并自动决策；需要额外授权时停止并留档。")}}
          p.settings-notice(role='status', aria-live='polite', *ngIf='scheduleNotice') {{t(scheduleNotice)}}
          p.settings-muted(role='status', *ngIf='scheduleLoading') {{t("正在读取定时任务…")}}
          p.memory-empty.settings-muted(*ngIf='!scheduleLoading && !scheduleData.tasks.length') {{t("暂无定时任务。可在对话中要求“每天北京时间 9 点检查服务并验证结果”。")}}
          article.memory-workflow(*ngFor='let task of scheduleData.tasks')
            .memory-row
              .memory-row-info
                strong {{task.title}}
                small.settings-muted {{task.cwd}}
                small.settings-muted {{t(scheduleStatus(task))}} · {{t(scheduleDescription(task))}}
                small.settings-muted {{t("下次：{0}", [(t(scheduleTime(task.nextRunAt)))])}}
              button.btn.btn-outline-secondary(type='button', (click)='scheduleAction("toggle", task)', [disabled]='scheduleSaving || scheduleLoading') {{task.enabled ? t("暂停后续触发") : t("恢复定时")}}
              button.btn.btn-outline-secondary(type='button', *ngIf='scheduleRun(task)', (click)='scheduleAction("stop", task)', [disabled]='scheduleSaving') {{t("停止本次运行")}}
              button.btn.btn-link.text-danger(type='button', (click)='scheduleDeleteId = task.id', [disabled]='scheduleSaving || scheduleLoading || !!scheduleRun(task)', [attr.aria-label]='t("删除定时任务：{0}", [task.title])', [attr.aria-expanded]='scheduleDeleteId === task.id') {{t("删除")}}
            p.settings-muted(*ngIf='scheduleRun(task)') {{t("运行中的任务需先停止，等待结束后再删除；其他窗口的运行请到对应窗口停止。")}}
            p.schedule-summary(*ngIf='scheduleLastRun(task)?.summary') {{t("最近结果：{0}", [(scheduleLastRun(task)?.summary)])}}
            details.schedule-details
              summary {{t("任务要求")}}
              pre(dir='auto') {{task.instructions}}
            .schedule-delete(*ngIf='scheduleDeleteId === task.id', role='group', [attr.aria-label]='t("确认删除定时任务")')
              p {{t("确认删除“{0}”及其执行记录？删除后不再触发，无法恢复。", [(task.title)])}}
              .memory-row
                button.btn.btn-outline-danger(type='button', (click)='scheduleAction("delete", task)', [disabled]='scheduleSaving || !!scheduleRun(task)') {{t("确认删除任务及记录")}}
                button.btn.btn-link(type='button', (click)='scheduleDeleteId = ""', [disabled]='scheduleSaving') {{t("取消")}}
      ng-container(*ngIf='memoryOpen && !schedulesOpen')
        .editor-heading
          span.provider-mark(aria-hidden='true') M
          .editor-identity
            .editor-eyebrow {{t("本地记忆")}}
            h4 {{t("任务流程与偏好")}}
            .editor-model.settings-muted {{t("少些重复探索，多些经验复用")}}
          button.btn.btn-outline-secondary.editor-default(type='button', (click)='refreshMemory()', [disabled]='memoryLoading') {{t("刷新")}}
        .editor-body.memory-manager
          label.memory-enable
            input(type='checkbox', [ngModel]='settings.taskMemoryEnabled !== false', (ngModelChange)='setTaskMemory($event)')
            span {{t("启用任务流程与别名")}}
          p.settings-muted {{t("仅用 /remember 开始录制任务；完成后设置别名，输入 /task1 即可执行。普通任务不会自动归档。")}}
          p.settings-notice(role='status', aria-live='polite', *ngIf='memoryNotice') {{t(memoryNotice)}}
          p.settings-muted(*ngIf='memoryLoading') {{t("正在读取本地流程库…")}}
          section.settings-section(aria-labelledby='memory-workflows-heading')
            h5#memory-workflows-heading.section-heading
              span.section-dot(aria-hidden='true')
              | {{t("任务流程 · {0}", [(memoryWorkflows.length)])}}
            p.memory-empty.settings-muted(*ngIf='!memoryLoading && !memoryWorkflows.length') {{t("还没有归档流程。让 Agent 完成一次终端任务并检查结果，确认目标完成后，流程会出现在这里。失败或未核对的任务不会归档。")}}
            .memory-workflow(*ngFor='let workflow of memoryWorkflows')
              .memory-row
                .memory-row-info
                  strong {{workflow.title}}
                  small.settings-muted {{workflow.cwd}}
                  small.settings-muted {{t("{0} · 完成 {1} 次 · 引用 {2} 次{3}", [(workflow.enabled ? t("已启用") : t("已停用")), (workflow.successes), (workflow.uses), (workflow.edited ? t(" · 已手动编辑") : '')])}}
                button.btn.btn-outline-secondary(type='button', (click)='editWorkflow(workflow)', [disabled]='memorySaving') {{t("编辑")}}
                button.btn.btn-link.text-danger(type='button', (click)='removeWorkflow(workflow)', [disabled]='memorySaving') {{t("删除")}}
              .memory-workflow-editor(*ngIf='workflowDraftId === workflow.id')
                .settings-fields
                  .settings-field.settings-field-wide
                    label(for='memory-workflow-alias') {{t("流程别名")}}
                    input#memory-workflow-alias.form-control([(ngModel)]='workflowAlias', placeholder='task1')
                  .settings-field.settings-field-wide
                    label(for='memory-workflow-title') {{t("流程名称")}}
                    input#memory-workflow-title.form-control([(ngModel)]='workflowTitle')
                  .settings-field.settings-field-wide
                    label(for='memory-workflow-objective') {{t("任务描述")}}
                    input#memory-workflow-objective.form-control([(ngModel)]='workflowObjective')
                    small.settings-muted {{t("流程通过别名调用，仅在上方工作目录中使用。")}}
                  .settings-field.settings-field-wide
                    label(for='memory-workflow-instructions') {{t("流程步骤")}}
                    textarea#memory-workflow-instructions.form-control(dir='auto', rows='8', [(ngModel)]='workflowInstructions')
                    small.settings-muted {{t("可整理操作顺序、检查点和需要替换的参数。手动编辑后，自动归档不会覆盖这些步骤。")}}
                label.memory-enable
                  input(type='checkbox', [(ngModel)]='workflowEnabled')
                  span {{t("启用此流程")}}
                .memory-row
                  button.btn.btn-primary(type='button', (click)='saveWorkflow()', [disabled]='memorySaving || !workflowTitle.trim() || !workflowObjective.trim() || !workflowInstructions.trim()') {{t("保存流程")}}
                  button.btn.btn-link(type='button', (click)='workflowDraftId = ""', [disabled]='memorySaving') {{t("收起")}}
          section.settings-section(aria-labelledby='memory-preferences-heading')
            h5#memory-preferences-heading.section-heading
              span.section-dot(aria-hidden='true')
              | {{t("操作偏好 · {0}", [(memoryPreferences.length)])}}
            p.settings-muted {{t("只记录你明确保存的偏好，例如“此项目使用 pnpm”“先运行检查再构建”。在此设置页保存到全局或指定工作目录。")}}
            .memory-preference(*ngFor='let preference of memoryPreferences')
              .memory-row
                .memory-row-info
                  strong {{preference.text}}
                  small.settings-muted {{preference.cwd || t("全局 · 所有工作目录")}}
                button.btn.btn-link(type='button', (click)='editPreference(preference)', [disabled]='memorySaving') {{t("编辑")}}
                button.btn.btn-link.text-danger(type='button', (click)='removePreference(preference)', [disabled]='memorySaving') {{t("删除")}}
            .settings-fields
              .settings-field.settings-field-wide
                label(for='memory-preference-text') {{preferenceDraftId ? t("编辑偏好") : t("添加偏好")}}
                textarea#memory-preference-text.form-control(dir='auto', rows='2', [(ngModel)]='preferenceDraft', [attr.placeholder]='t("例如：部署前先检查当前分支和目标主机")')
              .settings-field.settings-field-wide
                label(for='memory-preference-scope') {{t("适用范围")}}
                select#memory-preference-scope.form-control([(ngModel)]='preferenceScope')
                  option(value='global') {{t("全局")}}
                  option(value='workspace') {{t("指定工作目录")}}
              .settings-field.settings-field-wide(*ngIf='preferenceScope === "workspace"')
                label(for='memory-preference-cwd') {{t("完整工作目录")}}
                input#memory-preference-cwd.form-control([(ngModel)]='preferenceCwd', [attr.placeholder]='t("与侧栏显示的工作目录一致")')
            .memory-row.memory-preference-save
              button.btn.btn-outline-primary(type='button', (click)='savePreference()', [disabled]='memorySaving || !preferenceDraft.trim()') {{preferenceDraftId ? t("保存偏好") : t("添加偏好")}}
              button.btn.btn-link(type='button', *ngIf='preferenceDraftId', (click)='preferenceDraftId = ""; preferenceDraft = ""', [disabled]='memorySaving') {{t("取消编辑")}}
      ng-container(*ngIf='!schedulesOpen && !memoryOpen')
        ng-container(*ngIf='selectedProfile as profile; else codexSettings')
          .editor-heading
            span.provider-mark(aria-hidden='true') {{providerNames[profile.provider].slice(0, 1)}}
            .editor-identity
              .editor-eyebrow {{t("当前配置 · {0}", [(t(providerNames[profile.provider]))])}}
              h4 {{profile.name || t("未命名连接")}}
              .editor-model.settings-muted {{profile.model || t("尚未选择模型")}}
            span.default-badge(*ngIf='settings.defaultProfileId === profile.id') {{t("默认连接")}}
            button.btn.btn-outline-secondary.editor-default(type='button', *ngIf='settings.defaultProfileId !== profile.id', (click)='setDefault(profile.id)') {{t("设为默认")}}
          //- A keyed view resets scroll and field focus when switching connections.
          .editor-body(*ngFor='let current of [profile]; trackBy: trackProfile')
            section.settings-section(aria-labelledby='api-basic-heading')
              h5#api-basic-heading.section-heading
                span.section-dot(aria-hidden='true')
                | {{t("连接设置")}}
              .settings-fields
                .settings-field.settings-field-wide
                  label([attr.for]='"api-runtime-" + profile.id') {{t("Agent 运行时")}}
                  select.form-control([id]='"api-runtime-" + profile.id', [ngModel]='profile.runtime || "api"', (ngModelChange)='changeRuntime(profile, $event)')
                    option(value='api') {{t("内置 API Agent")}}
                    option(value='pi') Pi SDK
                  small.settings-muted(*ngIf='profile.runtime === "pi"') {{t("Pi 使用独立 Node 进程；仅开放 Tabby 工具，保留现有审批与终端策略。")}}
                .settings-field.settings-field-wide(*ngIf='profile.runtime === "pi"')
                  label([attr.for]='"pi-node-" + profile.id') {{t("Node 可执行文件（22.19 或更新版本）")}}
                  input.form-control([id]='"pi-node-" + profile.id', [(ngModel)]='profile.piNodeExecutable', (ngModelChange)='modelConnectionChanged(profile)', placeholder='node', spellcheck='false')
                .settings-field.settings-field-wide
                  label.settings-checkbox-label([attr.for]='"api-compact-" + profile.id')
                    input(type='checkbox', [id]='"api-compact-" + profile.id', [(ngModel)]='profile.autoCompact', (ngModelChange)='save()')
                    span {{t("自动压缩上下文")}}
                  small.settings-muted {{t("默认关闭；可先用 /compact 手动压缩。摘要会消耗模型额度，原始历史保留。")}}
                .settings-field
                  label([attr.for]='"api-name-" + profile.id') {{t("连接名称")}}
                  input.form-control([id]='"api-name-" + profile.id', [(ngModel)]='profile.name', (ngModelChange)='save()', [attr.placeholder]='t("为这个连接取个名字")')
                .settings-field
                  label([attr.for]='"api-provider-" + profile.id') {{t("供应商")}}
                  select.form-control([id]='"api-provider-" + profile.id', [ngModel]='profile.provider', (ngModelChange)='changeProvider(profile, $event)')
                    option(value='openai') OpenAI API
                    option(value='deepseek') DeepSeek
                    option(value='glm') {{t("GLM（智谱）")}}
                    option(value='kimi') Kimi API
                    option(value='kimi-coding') Kimi Coding Plan
                    option(value='bailian-coding') {{t("阿里云百炼 Coding Plan")}}
                    option(value='claude') Claude（Anthropic）
                    option(value='custom') {{t("自定义（OpenAI 兼容）")}}
                .settings-field.settings-field-wide(*ngIf='profile.provider === "custom"')
                  label([attr.for]='"api-format-" + profile.id') {{t("API 协议")}}
                  select.form-control([id]='"api-format-" + profile.id', [ngModel]='profile.apiFormat || "chat-completions"', (ngModelChange)='changeApiFormat(profile, $event)', [attr.aria-describedby]='"api-format-hint-" + profile.id')
                    option(value='chat-completions') Chat Completions · /chat/completions
                    option(value='responses') Responses · /responses
                  small.settings-muted([id]='"api-format-hint-" + profile.id') {{t("默认选择 Chat Completions；仅在服务明确支持时选择 Responses。终端任务需要流式响应和工具调用。")}}
                .settings-field.settings-field-wide(*ngIf='providerRegions[profile.provider]')
                  label([attr.for]='"api-region-" + profile.id') {{t("服务区域")}}
                  select.form-control([id]='"api-region-" + profile.id', [ngModel]='endpointRegion(profile)', (ngModelChange)='changeEndpointRegion(profile, $event)', [attr.aria-describedby]='"api-region-hint-" + profile.id')
                    option(value='china') {{t("中国内地")}}
                    option(value='international') {{t("国际")}}
                    option(*ngIf='endpointRegion(profile) === "custom"', value='custom') {{t("自定义地址")}}
                  small.settings-muted([id]='"api-region-hint-" + profile.id') {{t("按购买平台与区域选择端点和 Key。切换区域后请核对密钥；也可手动修改 Base URL。")}}
                .settings-field.settings-field-wide
                  label([attr.for]='"api-url-" + profile.id') {{t("Base URL")}}
                  input.form-control([id]='"api-url-" + profile.id', [(ngModel)]='profile.baseUrl', (ngModelChange)='modelConnectionChanged(profile)', [attr.aria-describedby]='"api-url-hint-" + profile.id', spellcheck='false')
                  small.settings-muted([id]='"api-url-hint-" + profile.id') {{t("填写基础地址，不含 /responses、/messages 或 /chat/completions。支持代理地址；GLM 按套餐选择端点。")}}
                  small.settings-muted(*ngIf='profile.provider === "custom"') {{t("示例：https://gateway.example/v1 或 http://localhost:1234/v1。保留服务要求的 /v1 等路径；HTTP 仅限本地回环地址。")}}
                  small.settings-muted(*ngIf='profile.provider === "kimi"') {{t("Kimi API 使用开放平台 Key，按量计费。海外端点：https://api.moonshot.ai/v1")}}
                  small.settings-muted(*ngIf='profile.provider === "kimi-coding"') {{t("使用 Kimi Code 控制台的套餐 Key，与普通 API Key 不通用。海外端点：https://api.kimi.ai/coding/v1。套餐限个人交互使用；定时任务请使用普通 API。")}}
                  small.settings-muted(*ngIf='profile.provider === "bailian-coding"') {{t("使用百炼 Coding Plan 专用 Key（sk-sp-），与按量 API Key 不通用。套餐限交互式编程；定时任务请使用按量 API。")}}
                .settings-field.settings-field-wide
                  label([attr.for]='"api-model-" + profile.id') {{t("模型 ID")}}
                  .settings-input-action
                    input.form-control([id]='"api-model-" + profile.id', [(ngModel)]='profile.model', (ngModelChange)='save()', (focus)='fetchModels(profile)', [attr.list]='"api-models-" + profile.id', [attr.placeholder]='t("选择或输入模型 ID")', [attr.aria-describedby]='"api-model-hint-" + profile.id')
                    button.btn.btn-outline-secondary(type='button', (click)='fetchModels(profile, true)', [disabled]='modelLists[profile.id]?.running') {{modelLists[profile.id]?.running ? t("获取中…") : t("获取模型")}}
                  datalist([id]='"api-models-" + profile.id')
                    option(*ngFor='let model of modelLists[profile.id]?.models', [value]='model.model') {{model.displayName}}
                  small.settings-muted([id]='"api-model-hint-" + profile.id') {{t("聚焦时自动获取模型列表，也可手动输入完整模型 ID。")}}
                  p.field-notice(role='status', aria-live='polite', *ngIf='modelLists[profile.id]') {{modelLists[profile.id].notice}}
            section.settings-section(aria-labelledby='api-auth-heading')
              h5#api-auth-heading.section-heading
                span.section-dot(aria-hidden='true')
                | {{t("身份验证")}}
              .settings-fields
                .settings-field.settings-field-wide
                  label([attr.for]='"api-source-" + profile.id') {{t("密钥来源")}}
                  select.form-control([id]='"api-source-" + profile.id', [ngModel]='keySource(profile)', (ngModelChange)='changeKeySource(profile, $event)')
                    option(value='direct') {{t("直接输入")}}
                    option(value='environment') {{t("环境变量")}}
                    option(*ngIf='profile.provider === "custom"', value='none') {{t("无需密钥")}}
                    option(*ngIf='keySource(profile) === "vault"', value='vault', disabled='') {{t("旧 Vault 配置（请选择其他来源）")}}
                .settings-field.settings-field-wide(*ngIf='keySource(profile) === "direct"')
                  label([attr.for]='"api-key-" + profile.id') {{t("API Key")}}
                  input.form-control(type='password', [id]='"api-key-" + profile.id', [(ngModel)]='profile.apiKey', (ngModelChange)='modelConnectionChanged(profile)', autocomplete='off', spellcheck='false', [attr.aria-describedby]='"api-key-hint-" + profile.id')
                  small.settings-muted([id]='"api-key-hint-" + profile.id') {{t("由插件保存在本地 Tabby 配置中。")}}
                .settings-field.settings-field-wide(*ngIf='keySource(profile) === "environment"')
                  label([attr.for]='"api-env-" + profile.id') {{t("环境变量名")}}
                  input.form-control([id]='"api-env-" + profile.id', [(ngModel)]='profile.apiKeyEnv', (ngModelChange)='modelConnectionChanged(profile)')
                  small.settings-muted {{t("使用 Tabby 进程继承的环境变量，修改变量后需要重启 Tabby。")}}
                p.settings-notice(*ngIf='keySource(profile) === "vault"', role='status') {{t("插件不再访问 Vault。请选择直接输入或环境变量，并重新配置 API Key。")}}
                p.settings-notice(*ngIf='keySource(profile) === "none"', role='status') {{t("仅用于不需要认证的服务；不会发送 Authorization 请求头。")}}
            .settings-advanced
              button.advanced-toggle(type='button', (click)='advancedOpen = !advancedOpen', [attr.aria-expanded]='advancedOpen', aria-controls='api-advanced-fields')
                span.advanced-chevron(aria-hidden='true') {{advancedOpen ? '−' : '+'}}
                span
                  strong {{t("高级参数")}}
                  small.settings-muted {{t("思考模式、推理强度、上下文与工具限制")}}
              #api-advanced-fields.settings-fields(*ngIf='advancedOpen')
                .settings-field
                  label([attr.for]='"api-thinking-" + profile.id') {{t("思考模式")}}
                  select.form-control([id]='"api-thinking-" + profile.id', [(ngModel)]='profile.thinking', (ngModelChange)='save()', [disabled]='profile.provider === "openai" || profile.provider === "custom"')
                    option(value='default') {{t("服务商默认")}}
                    option(value='enabled') {{t("开启")}}
                    option(value='disabled') {{t("关闭")}}
                  small.settings-muted {{t("Claude 开启时使用 adaptive thinking；OpenAI 使用推理强度。")}}
                  small.settings-muted(*ngIf='profile.provider === "custom"') {{t("自定义接口不发送厂商专用 Thinking 参数；推理强度留空时不发送，请按服务文档填写。")}}
                .settings-field
                  label([attr.for]='"api-effort-" + profile.id') {{t("推理强度（可选）")}}
                  input.form-control([id]='"api-effort-" + profile.id', [(ngModel)]='profile.reasoningEffort', (ngModelChange)='save()', [attr.placeholder]='t("服务商默认")')
                  small.settings-muted {{t("按模型文档填写原始值；留空不发送。")}}
                .settings-field
                  label([attr.for]='"api-context-" + profile.id') {{t("上下文窗口 tokens")}}
                  input.form-control(type='number', [id]='"api-context-" + profile.id', min='0', [(ngModel)]='profile.contextWindow', (ngModelChange)='save()')
                  small.settings-muted {{t("0 表示未知，用于显示使用占比，不代表账户额度。")}}
                .settings-field
                  label([attr.for]='"api-output-" + profile.id') {{t("单次最大输出 tokens")}}
                  input.form-control(type='number', [id]='"api-output-" + profile.id', min='256', max='131072', [(ngModel)]='profile.maxOutputTokens', (ngModelChange)='save()')
                .settings-field.settings-field-wide
                  label([attr.for]='"api-iterations-" + profile.id') {{t("每回合工具轮数上限")}}
                  input.form-control(type='number', [id]='"api-iterations-" + profile.id', min='0', max='100', [ngModel]='profile.maxIterations', (ngModelChange)='setToolRoundLimit(profile, $event)')
                  small.settings-muted {{t("0 表示不限固定轮数（默认）。1–100 限制工具调用轮数，另留收尾请求读取最后结果及更新目标；停止和目标 token 预算仍然生效。")}}
            .settings-test
              .settings-test-actions
                button.btn.btn-outline-primary(type='button', (click)='testProfile(profile)', [disabled]='connectionTests[profile.id]?.running') {{connectionTests[profile.id]?.running ? t("测试中…") : t("测试连接")}}
                button.btn.btn-link(type='button', *ngIf='connectionTests[profile.id]?.running', (click)='cancelTest(profile)') {{t("取消测试")}}
                small.settings-muted {{t("发送简短请求，产生少量 API 用量。")}}
              p.field-notice(role='status', aria-live='polite', *ngIf='connectionTests[profile.id]') {{t(connectionTests[profile.id].notice)}}
            .settings-remove
              button.btn.btn-outline-danger(type='button', (click)='removeProfile(profile)') {{t("移除此连接")}}
        ng-template(#codexSettings)
          .editor-heading
            span.provider-mark(aria-hidden='true') C
            .editor-identity
              .editor-eyebrow {{t("当前配置 · 本机引擎")}}
              h4 {{claudeCodeSelected ? "Claude Code" : "Codex"}}
              .editor-model.settings-muted {{claudeCodeSelected ? t("使用本机 Claude Code 登录") : t("使用本机 Codex CLI 登录")}}
            span.default-badge(*ngIf='settings.defaultProfileId === (claudeCodeSelected ? "claude-code" : "")') {{t("默认连接")}}
            button.btn.btn-outline-secondary.editor-default(type='button', *ngIf='settings.defaultProfileId !== (claudeCodeSelected ? "claude-code" : "")', (click)='setDefault(claudeCodeSelected ? "claude-code" : "")') {{t("设为默认")}}
          .editor-body
            section.settings-section(aria-labelledby='codex-engine-heading')
              h5#codex-engine-heading.section-heading
                span.section-dot(aria-hidden='true')
                | {{t("本机引擎")}}
              .settings-fields
                .settings-field.settings-field-wide(*ngIf='!claudeCodeSelected')
                  label(for='codex-executable') {{t("Codex CLI 可执行文件")}}
                  input#codex-executable.form-control([(ngModel)]='settings.executable', (ngModelChange)='save()', [attr.placeholder]='t("自动查找（codex）")')
                  small.settings-muted {{t("留空自动查找；也可填写完整路径或命令名，不附加参数。先运行 codex login 完成登录。")}}
                  details.executable-help
                    summary.settings-muted {{t("查看路径查找说明")}}
                    p.settings-muted {{t("Codex 自动查找支持 PATH、standalone（含 CODEX_HOME）、Homebrew/npm、macOS 桌面包及 IDE 扩展兜底。也支持 CODEX_INSTALL_DIR、含空格路径和 ~/ 路径。显式路径无效会报错，自定义命令名仅查 PATH。设置键：codexAgent.executable。")}}
                .settings-field.settings-field-wide(*ngIf='claudeCodeSelected')
                  label(for='claude-executable') {{t("Claude Code CLI 可执行文件")}}
                  input#claude-executable.form-control([(ngModel)]='settings.claudeExecutable', (ngModelChange)='save()', placeholder='claude', aria-describedby='claude-login-help')
                  small#claude-login-help.settings-muted {{t("先在本机终端运行 claude auth login，再用 claude auth status 检查。插件复用官方 CLI 登录，不保存订阅凭据。")}}
                  small.settings-muted {{t("订阅用户请选择 Claude 账号登录。API Key 或云平台配置可能使用独立计费，请以官方 CLI 认证状态为准。")}}
                .settings-field.settings-field-wide
                  label(for='codex-cwd') {{t("固定工作目录")}}
                  input#codex-cwd.form-control([(ngModel)]='settings.cwd', (ngModelChange)='save()', [attr.placeholder]='t("留空表示自动识别")')
                  small.settings-muted {{t("留空时使用当前本地终端的工作目录。")}}
                .settings-field.settings-field-wide(*ngIf='!claudeCodeSelected')
                  label(for='codex-model') {{t("模型")}}
                  input#codex-model.form-control([(ngModel)]='settings.model', (ngModelChange)='save()', [attr.placeholder]='t("Codex CLI 默认模型")')
                .settings-field.settings-field-wide(*ngIf='claudeCodeSelected')
                  label(for='claude-model') {{t("模型")}}
                  input#claude-model.form-control([(ngModel)]='settings.claudeModel', (ngModelChange)='save()', placeholder='sonnet / opus / haiku', aria-describedby='claude-model-help')
                  small#claude-model-help.settings-muted {{t("支持官方模型别名或完整模型 ID；实际可用模型与用量取决于账号权益。")}}
                .settings-field.settings-field-wide(*ngIf='claudeCodeSelected')
                  label(for='claude-effort') {{t("推理强度（可选）")}}
                  input#claude-effort.form-control([(ngModel)]='settings.claudeReasoningEffort', (ngModelChange)='save()', placeholder='low / medium / high', aria-describedby='claude-permission-help')
                  small#claude-permission-help.settings-muted {{t("终端工具沿用插件权限和审批；本机 Claude Code 的内置 Shell、文件工具及自定义 hooks 不启用。此模式不提供操作系统沙箱。")}}
            section.settings-section(aria-labelledby='codex-permissions-heading')
              h5#codex-permissions-heading.section-heading
                span.section-dot(aria-hidden='true')
                | {{t("权限与预算")}}
              .settings-fields
                .settings-field
                  label(for='codex-approval') {{t("审批策略")}}
                  select#codex-approval.form-control([(ngModel)]='settings.approvalPolicy', (ngModelChange)='save()')
                    option(value='on-request') {{t("按需询问")}}
                    option(value='untrusted') {{t("不可信命令询问")}}
                    option(value='never') {{t("不询问")}}
                .settings-field
                  label(for='codex-sandbox') {{t("沙箱")}}
                  select#codex-sandbox.form-control([(ngModel)]='settings.sandbox', (ngModelChange)='save()')
                    option(value='workspace-write') {{t("工作目录可写")}}
                    option(value='read-only') {{t("只读")}}
                    option(value='danger-full-access') {{t("完全访问")}}
                .settings-field.settings-field-wide
                  label(for='codex-budget') {{t("每个目标的 token 上限")}}
                  input#codex-budget.form-control(type='number', min='0', [(ngModel)]='settings.goalTokenBudget', (ngModelChange)='save()')
                  small.settings-muted {{t("0 表示不设置上限。达到上限会显示未完成状态。")}}
  p.settings-footer.settings-muted {{t("配置自动保存。修改连接参数后，在侧栏点击连接图标应用；切换连接保留当前对话，输入 /new 开始新对话。")}}
