.codex-agent([attr.dir]='direction', [attr.lang]='languageCode')
  .codex-header
    .codex-heading
      strong {{agentLabel}}
      small([attr.title]='cwd || t("未设置工作目录")') {{shortCwd}}
    .codex-actions
      button.codex-connection.btn.btn-sm(type='button', [class.codex-connected]='connected', [class.codex-connecting]='loading', [class.codex-disconnected]='!loading && !connected', (click)='reconnectAgent()', [disabled]='loading || busy || !!request || modelSaving', [attr.title]='loading ? t("正在连接") : claudeCodeMode ? t("应用 Claude Code 配置并恢复会话") : apiMode ? t("应用 API 连接配置并恢复会话") : t("重新连接 Codex")', [attr.aria-label]='t("{0} {1}，点击重连", [agentLabel, t(connectionLabel)])')
        i.fas([class.fa-link]='connected', [class.fa-unlink]='!connected', aria-hidden='true')
      button.codex-details-toggle.btn.btn-outline-secondary.btn-sm(type='button', (click)='toggleStatus()', [attr.aria-expanded]='statusOpen', [attr.aria-label]='statusOpen ? t("收起状态详情") : t("展开状态详情")', [attr.title]='t("展开或收起状态详情")') {{t("详情")}}
      button.btn.btn-outline-secondary.btn-sm(type='button', (click)='closeRequested.emit()', [attr.title]='t("收起侧栏")', [attr.aria-label]='t("收起侧栏")') ×
  .codex-connection-controls
    select.codex-profile-select.form-control.form-control-sm([ngModel]='profileId', (ngModelChange)='selectConnection($event)', [disabled]='loading || busy || !!request || modelSaving', [attr.aria-label]='t("选择 AI 连接")', [attr.title]='apiMode ? agentLabel : t("Codex（本机登录）")')
      option(value='') {{t("Codex（本机登录）")}}
      option(value='claude-code') {{t("Claude Code（本机登录）")}}
      option(*ngFor='let profile of apiProfiles', [value]='profile.id') {{profile.name}} · {{profile.provider}}
    .codex-model-controls
      button.codex-model-summary(type='button', (click)='openModelPicker()', [disabled]='loading || modelLoading || modelSaving || (apiMode && busy)', [attr.title]='t("当前模型：{0}；reasoning：{1}；点击切换，下回合生效", [modelLabel, reasoningLabel])', [attr.aria-label]='t("当前模型与 reasoning 等级，点击切换")')
        span.codex-current-model {{modelLabel}}
        span.codex-current-reasoning reasoning: {{reasoningLabel}}
  .codex-api-thinking(*ngIf='apiMode && !claudeCodeMode && supportsThinkingToggle')
    label([attr.for]='"api-thinking-" + threadId') {{t("Thinking")}}
    select.form-control.form-control-sm(*ngIf='supportsThinkingToggle', [id]='"api-thinking-" + threadId', [ngModel]='apiThinking', (ngModelChange)='setApiThinking($event, settings.reasoningEffort)', [disabled]='loading || busy || !!request || modelSaving', [attr.aria-label]='t("Thinking 模式")')
      option(value='default') {{t("服务商默认")}}
      option(value='enabled') {{t("开启")}}
      option(value='disabled') {{t("关闭")}}
  small.codex-detail-error(*ngIf='connectionError') {{t(connectionError)}}
  small.codex-detail-error(*ngIf='apiMode && modelError', role='alert') {{t(modelError)}}
  .codex-summary
    button.codex-status(type='button', [class.codex-done]='status === "任务已完成"', (click)='toggleStatus()', [attr.title]='t(t(status))', [attr.aria-expanded]='statusOpen', [attr.aria-label]='t("任务状态：{0}；展开或收起详情", [t(status)])') {{t(status)}}
    button.codex-summary-item.codex-context-summary(type='button', (click)='toggleStatus()', [attr.aria-expanded]='statusOpen', [attr.title]='apiMode && !claudeCodeMode ? t("上次 API 请求输入占上下文窗口的比例；下一次请求可能增加；点击查看详情") : t("上下文使用占比；点击查看 token 用量和会话累计")')
      span(*ngIf='contextWindowTokens !== null && contextUsedTokens !== null') {{t("上下文 {0}%", [(contextPercent | number:'1.0-0')])}}
      span(*ngIf='contextWindowTokens === null || contextUsedTokens === null') {{t("上下文 —")}}
    .codex-control-summary([class.codex-control-active]='controlledTabs.length > 0')
      button.codex-summary-item(type='button', (click)='toggleStatus()', [attr.aria-expanded]='statusOpen', [attr.title]='controlledTabs.length ? t("当前控制 {0} 个终端，输入已锁定；点击查看列表", [controlledTabs.length]) : t("当前未控制终端，用户可操作")') {{t("控 {0}", [(controlledTabs.length || '—')])}}
      button.codex-release-all(type='button', *ngIf='controlledTabs.length', (click)='releaseControlledTabs()', [attr.title]='t("临时释放全部受控终端，取回输入权")', [attr.aria-label]='t("临时释放全部受控终端")') {{t("释放")}}
    button.codex-summary-item.codex-forward-summary(type='button', (click)='toggleStatus()', [attr.aria-expanded]='statusOpen', [attr.title]='t("自动转发已停用；执行中由 AI 用 read_tab 按需读取。")') {{t("转发关")}}
  .codex-status-detail(*ngIf='statusOpen')
    .codex-detail-heading
      strong {{t("当前状态")}}
      .codex-detail-actions
        button.btn.btn-link.btn-sm(type='button', (click)='openStatus()', [disabled]='statusLoading', [attr.aria-label]='t("刷新状态详情")') {{t("刷新")}}
        button.btn.btn-link.btn-sm(type='button', (click)='toggleStatus()', [attr.aria-label]='t("关闭状态详情")') ×
    .codex-detail-body
      small(*ngIf='statusLoading') {{t("正在更新…")}}
      small.codex-detail-error(*ngIf='statusError') {{t(statusError)}}
      .codex-detail-grid
        span {{t("连接")}}
        strong {{t(connectionLabel)}}
        span(*ngIf='apiMode') {{t("供应商")}}
        strong(*ngIf='apiMode') {{agentLabel}} · {{claudeCodeMode ? t("本机引擎") : "API"}}
        span {{t("任务状态")}}
        strong.codex-detail-status {{t(status)}}
        span {{t("工作目录")}}
        strong {{cwd || t("未设置")}}
        span {{t("会话")}}
        strong {{threadId || t("未连接")}}
        span {{t("回合")}}
        strong {{t(turnLabel)}}
        span {{t("会话状态（查询时）")}}
        strong {{t(threadStateLabel)}}
        span {{t("当前模型（查询时）")}}
        strong {{threadStatus?.model || t("未上报")}}
        span(*ngIf='runtimeInfo') {{t("Agent 运行时")}}
        strong(*ngIf='runtimeInfo') {{runtimeInfo}}
        span {{apiMode ? t("配置中的模型（重连生效）") : t("下回合模型")}}
        strong {{settings.model || t("Codex 默认配置")}}
        span {{t("当前推理强度（查询时）")}}
        strong {{threadStatus?.reasoningEffort || t("未上报")}}
        span {{t("下回合推理强度")}}
        strong {{settings.reasoningEffort || (apiMode ? t("服务商默认") : t("Codex 默认配置"))}}
        span {{apiMode ? t("上次请求输入") : t("上下文")}}
        strong(*ngIf='contextUsedTokens !== null && contextWindowTokens !== null') {{contextUsedTokens | number:'1.0-0'}} / {{contextWindowTokens | number:'1.0-0'}} tokens（{{contextPercent | number:'1.0-0'}}%）
        strong(*ngIf='contextUsedTokens === null || contextWindowTokens === null') {{t("未上报")}}
        span {{apiMode ? t("已上报用量累计") : t("会话累计")}}
        strong {{sessionTotalTokens === null ? t("未上报") : (sessionTotalTokens | number:'1.0-0') + ' tokens'}}
        span(*ngIf='!apiMode') {{t(rateLimitLabel(statusRateLimits?.primary))}}
        strong(*ngIf='!apiMode') {{t(rateLimitValue(statusRateLimits?.primary))}}
        span(*ngIf='!apiMode && statusRateLimits?.secondary') {{t(rateLimitLabel(statusRateLimits?.secondary))}}
        strong(*ngIf='!apiMode && statusRateLimits?.secondary') {{t(rateLimitValue(statusRateLimits?.secondary))}}
        span(*ngIf='!apiMode') {{t("普通用量")}}
        strong(*ngIf='!apiMode') {{t(ordinaryUsageLabel)}}
        span {{t("目标")}}
        strong {{t(goalLabel)}}
        span {{apiMode ? t("下回合工具策略") : t("下回合文件权限")}}
        strong {{apiMode ? (settings.sandbox === 'read-only' ? t("只读：禁止终端输入和控件操作") : t("可操作终端：使用终端账户权限")) : (settings.sandbox === 'read-only' ? t("只读") : settings.sandbox === 'workspace-write' ? t("工作区可写") : t("完全访问"))}}
        span {{t("下回合审批")}}
        strong {{settings.approvalPolicy === 'on-request' ? t("按需") : settings.approvalPolicy === 'untrusted' ? t("不可信时") : t("不询问")}}
      .codex-detail-section
        strong {{t("终端控制（{0}）", [(controlledTabs.length)])}}
        small(*ngIf='!controlledTabs.length') {{t("当前无控制，终端可由用户操作。")}}
        .codex-tab-control(*ngFor='let control of controlledTabs')
          span {{t("{0}（{1}） · 命令执行中，终端输入已锁定 · {2}", [(control.title), (control.tabId), (control.command)])}}
          button.btn.btn-outline-secondary.btn-sm(type='button', (click)='releaseControlledTab(control.tabId)', [attr.aria-label]='t("临时释放终端 {0}", [control.title])') {{t("临时释放")}}
      .codex-detail-section
        strong {{t("终端上下文")}}
        small {{t("自动转发已停用；执行中由 AI 用 read_tab 按需读取。")}}
        small(*ngIf='sourceTerminal') {{t("已绑定终端：{0}。仅在发送或继续时附带有界摘要。", [(sourceTerminal.title)])}}
        small(*ngIf='!sourceTerminal') {{t("可从目标终端点击工具栏图标绑定；Codex 仍可按需访问所有标签。")}}
        button.btn.btn-outline-secondary.btn-sm(type='button', *ngIf='sourceTerminal', (click)='unbindSource()') {{t("解除绑定")}}
  .codex-history(*ngIf='historyOpen')
    .codex-history-heading
      strong {{t("当前目录的 Tabby AI Tools 会话")}}
      .codex-history-actions
        button.btn.btn-link.btn-sm(type='button', (click)='loadSessions(true)', [disabled]='!canBrowseHistory') {{t("刷新")}}
        button.btn.btn-link.btn-sm(type='button', (click)='historyOpen = false', [attr.aria-label]='t("关闭历史会话")') ×
    small.codex-history-path {{cwd}}
    small(*ngIf='!busy && !request') {{t("点击会话恢复，或用 ↑↓ 选择、Enter 恢复、Esc 关闭")}}
    small(*ngIf='busy || request') {{request ? t("请先处理当前提问或审批，再恢复会话") : t("当前任务执行中，请先停止再恢复会话")}}
    button.btn.btn-outline-danger.btn-sm(type='button', *ngIf='busy && !request', (click)='stop()', [disabled]='!turnId || loading') {{t("停止当前任务")}}
    .codex-history-error(*ngIf='historyError') {{t(historyError)}}
    .codex-history-empty(*ngIf='!historyLoading && !sessions.length') {{sessionCursor ? t("本页没有可复用会话，可继续加载") : t("暂无可复用的历史会话")}}
    .codex-session-list(*ngIf='sessions.length', (keydown)='onPromptKeydown($event)')
      button.codex-session(type='button', *ngFor='let session of sessions; let index = index', (focus)='sessionSelection = index', (click)='selectSession(session)', [disabled]='loading || historyLoading || busy || !!request', [class.codex-session-current]='session.id === threadId', [class.codex-session-selected]='index === sessionSelection', [attr.title]='session.name || session.preview || session.id')
        span.codex-session-title {{session.name || session.preview || t("未命名会话")}}
        span.codex-session-meta {{formatDateTime(session.updatedAt * 1000)}} · {{session.id === threadId ? t("当前会话") : session.id.slice(0, 8)}}
    .codex-history-footer
      small(*ngIf='historyLoading') {{t("正在读取会话…")}}
      button.btn.btn-primary.btn-sm(type='button', *ngIf='sessions.length', (click)='selectSession(sessions[sessionSelection])', [disabled]='loading || historyLoading || busy || !!request') {{t("恢复所选会话")}}
      button.btn.btn-outline-secondary.btn-sm(type='button', *ngIf='sessionCursor && !historyLoading', (click)='loadSessions()', [disabled]='!canBrowseHistory') {{t("加载更多")}}
  .codex-output-note(*ngIf='historyNotice') {{t(historyNotice)}}
  .codex-output-note(*ngIf='outputNotice') {{t(outputNotice)}}
  .codex-feed-container
    .codex-feed(#chatFeed='', tabindex='0', [attr.aria-label]='t("对话消息")')
      .codex-feed-content(#chatContent='')
        .codex-entry(*ngFor='let entry of entries', [class.codex-user]='entry.kind === "user"', [class.codex-tool]='entry.kind === "tool"')
          .codex-entry-header
            .codex-role {{entry.kind === 'user' ? t("你") : entry.kind === 'tool' ? t("工具输出") : entry.kind === 'system' ? t("系统") : t("助手")}}
            button.btn.btn-link.btn-sm.codex-copy(type='button', (click)='copyEntry(entry)', [attr.aria-label]='t("复制{0}", [entry.kind === \'user\' ? t("你的消息") : t("Codex 消息")])') {{copiedEntryId === entry.id ? t("已复制") : t("复制")}}
          .codex-text(dir='auto') {{entry.kind === "system" ? t(entry.text) : entry.text}}
    button.codex-jump-latest(type='button', *ngIf='showJumpToLatest', (click)='jumpToLatest()', [attr.aria-label]='t("回到最新消息并恢复自动滚动")', [attr.title]='t("回到底部并恢复自动滚动")')
      span(aria-hidden='true') ↓
      span {{t("回到最新消息")}}
  .codex-request(*ngIf='request')
    strong {{request.translateTitle ? t(request.title) : request.title}}
    a(*ngIf='request.url', [href]='request.url', target='_blank', rel='noopener noreferrer') {{t("打开授权链接")}}
    .codex-question(*ngFor='let question of request.questions')
      strong(*ngIf='question.header') {{question.header}}
      p {{question.question}}
      .codex-options(*ngIf='question.options?.length')
        button.btn.btn-sm.codex-option(type='button', *ngFor='let option of question.options', [class.btn-primary]='request.answers[question.id] === option.label', [class.btn-outline-secondary]='request.answers[question.id] !== option.label', (click)='request.answers[question.id] = option.label')
          strong {{option.label}}
          small(*ngIf='option.description') {{option.description}}
        button.btn.btn-sm.codex-option(type='button', *ngIf='question.isOther', [class.btn-primary]='request.answers[question.id] === "__other__"', [class.btn-outline-secondary]='request.answers[question.id] !== "__other__"', (click)='request.answers[question.id] = "__other__"') {{t("其他")}}
      input.form-control(*ngIf='question.isOther && request.answers[question.id] === "__other__"', [type]='question.isSecret ? "password" : "text"', [(ngModel)]='request.otherAnswers[question.id]', [attr.placeholder]='t("输入其他答案")')
      input.form-control(*ngIf='!question.options?.length', [type]='question.isSecret ? "password" : "text"', [(ngModel)]='request.answers[question.id]', [attr.placeholder]='t("输入回答")')
    .codex-request-actions
      button.btn.btn-primary.btn-sm(type='button', (click)='decide("accept")', [disabled]='isUserInputRequest() && !canSubmitRequest()') {{isUserInputRequest() ? t("提交答案") : t("允许")}}
      button.btn.btn-outline-secondary.btn-sm(type='button', (click)='decide("decline")') {{isUserInputRequest() ? t("跳过") : t("拒绝")}}
  .codex-compose
    .codex-schedules(*ngIf='schedulePanelOpen', [attr.aria-label]='t("定时 AI 任务")')
      .codex-detail-heading
        strong {{t("定时任务与执行记录")}}
        .codex-detail-actions
          button.btn.btn-link.btn-sm(type='button', (click)='scheduleAction("refresh")', [disabled]='scheduleLoading') {{t("刷新")}}
          button.btn.btn-link.btn-sm(type='button', (click)='schedulePanelOpen = false', [attr.aria-label]='t("关闭定时任务面板")') ×
      small {{t("通过对话创建，例如“每天北京时间 9 点检查服务，异常时分析日志并修复，最多尝试 3 次，最后验证恢复”。仅在 Tabby 打开时执行。")}}
      small(*ngIf='scheduleLoading', role='status') {{t("正在处理定时任务…")}}
      small.codex-detail-error(*ngIf='scheduleError || scheduledServiceError', role='alert') {{t(scheduleError || scheduledServiceError)}}
      .codex-scheduled-approval(*ngIf='scheduledApproval', role='status')
        strong {{t("定时任务等待你的审批")}}
        pre(dir='auto') {{scheduledApproval.title}}
        .codex-request-actions
          button.btn.btn-primary.btn-sm(type='button', (click)='decideScheduledApproval(true)') {{t("允许本次操作")}}
          button.btn.btn-outline-secondary.btn-sm(type='button', (click)='decideScheduledApproval(false)') {{t("拒绝并停止")}}
      .codex-schedule-list
        small(*ngIf='!scheduleLoading && !scheduledTasks.length') {{t("当前目录暂无定时任务。")}}
        article.codex-schedule(*ngFor='let task of scheduledTasks')
          strong {{task.title}}
          small {{task.enabled ? t("已启用") : task.schedule.type === 'at' && task.nextRunAt === null ? t("单次已触发") : t("已暂停")}} · {{t(scheduleDescription(task))}}
          small {{t("下次：{0} · {1} · {2}", [(t(scheduleTime(task.nextRunAt))), (scheduledConnectionLabel(task)), ((task.modelCheck ? task.modelCheck.requestedModel : task.settings.model) || t("默认模型"))])}}
          small {{t(scheduledPermissionLabel(task))}}
          small(*ngIf='task.modelSelectionReason') {{t("选模说明：{0}", [(task.modelSelectionReason)])}}
          small(*ngIf='task.modelCheck') {{task.modelCheck.fallbackUsed ? t("首选测试失败，默认模型测试通过；运行时重试首选") : t("模型测试通过")}} · {{t(scheduleTime(task.modelCheck.testedAt))}}
          .codex-request-actions
            button.btn.btn-outline-secondary.btn-sm(type='button', (click)='scheduleAction("toggle", task)', [disabled]='scheduleLoading') {{task.enabled ? t("暂停后续触发") : t("恢复定时")}}
            button.btn.btn-outline-secondary.btn-sm(type='button', (click)='scheduleAction("run", task)', [disabled]='scheduleLoading || scheduledTaskRunning(task)') {{t("立即运行")}}
            button.btn.btn-link.btn-sm(type='button', (click)='selectedScheduledTaskId = selectedScheduledTaskId === task.id ? "" : task.id', [attr.aria-expanded]='selectedScheduledTaskId === task.id') {{t("执行记录")}}
          .codex-scheduled-records(*ngIf='selectedScheduledTaskId === task.id')
            pre(dir='auto') {{task.instructions}}
            small(*ngIf='!scheduledRuns.length') {{t("暂无执行记录。")}}
            details(*ngFor='let run of scheduledRuns', #runDetails='', (toggle)='expandedScheduledRunId = run.id')
              summary {{t(scheduleTime(run.startedAt))}} · {{t(scheduledRunLabel(run))}}
              p {{run.summary || t("正在执行，尚未确认完成")}}
              small {{t("计划时间：{0} · 结束：{1}", [(t(scheduleTime(run.scheduledAt))), (run.finishedAt ? scheduleTime(run.finishedAt) : t("尚未结束"))])}}
              small {{t("运行 ID：{0} · 会话：{1}", [(run.id), (run.threadId || t("连接中"))])}}
              small(*ngIf='run.model !== undefined') {{t("本次模型：{0} · 推理强度：{1}", [(run.model || t("Codex 默认")), (run.reasoningEffort || t("默认"))])}}
              small(*ngIf='run.modelSelectionReason') {{t("选模说明：{0}", [(run.modelSelectionReason)])}}
              small(*ngIf='run.modelCheck') {{t("本次模型测试通过{0}", [(run.modelCheck.fallbackUsed ? t(" · 已回退默认模型") : '')])}}
              small(*ngIf='run.probeTokens') {{t("模型测试 Token：{0}", [(run.probeTokens)])}}
              small(*ngIf='run.totalTokens !== undefined') Token：{{run.totalTokens}}
              button.btn.btn-outline-danger.btn-sm(type='button', *ngIf='run.status === "running" || run.status === "waiting_approval"', (click)='scheduleAction("stop", undefined, run)', [disabled]='scheduleLoading') {{t("停止本次运行")}}
              ng-container(*ngIf='runDetails.open')
                .codex-run-entry(*ngFor='let entry of run.entries')
                  small {{t(scheduleTime(entry.at))}} · {{t(scheduledEntryLabel(entry.kind))}}
                  pre(dir='auto') {{entry.text}}
    .codex-workflows(*ngIf='workflowPanelOpen')
      .codex-detail-heading
        strong {{t("当前目录的任务流程")}}
        .codex-detail-actions
          button.btn.btn-link.btn-sm(type='button', (click)='openWorkflows()', [disabled]='workflowLoading') {{t("刷新")}}
          button.btn.btn-link.btn-sm(type='button', (click)='workflowPanelOpen = false', [attr.aria-label]='t("关闭任务流程库")') ×
      small(*ngIf='workflowLoading') {{t("正在读取本地流程…")}}
      small.codex-detail-error(*ngIf='workflowError', role='status') {{t(workflowError)}}
      small(*ngIf='!workflowLoading && !workflowError && !workflows.length') {{t("用 /remember 任务描述 开始录制；完成后设置别名，使用 /task1 执行。")}}
      .codex-workflow-list
        .codex-workflow(*ngFor='let workflow of workflows')
          button.codex-workflow-heading(type='button', (click)='expandedWorkflowId = expandedWorkflowId === workflow.id ? "" : workflow.id', [attr.aria-expanded]='expandedWorkflowId === workflow.id')
            strong {{workflow.alias ? "/" + workflow.alias + " · " + workflow.title : workflow.title}}
            small {{t("{0} · 完成 {1} 次", [(workflow.enabled ? t("已启用") : t("已停用")), (workflow.successes)])}}
          pre(dir='auto', *ngIf='expandedWorkflowId === workflow.id') {{workflowText(workflow)}}
          button.btn.btn-outline-secondary.btn-sm(type='button', (click)='useWorkflow(workflow)', [disabled]='busy || !workflow.enabled') {{t("填入任务")}}
    .codex-memory-notice(*ngIf='memoryNotice', role='status') {{t(memoryNotice)}}
    .codex-memory-actions(*ngIf='pendingWorkflow')
      label(for='workflow-alias') {{t("流程别名")}}
      input#workflow-alias.form-control.form-control-sm([(ngModel)]='workflowAlias', placeholder='task1', [disabled]='busy')
      button.btn.btn-outline-primary.btn-sm(type='button', (click)='saveWorkflowAlias()', [disabled]='busy || !workflowAlias.trim()') {{t("保存别名")}}
      button.btn.btn-link.btn-sm(type='button', (click)='pendingWorkflow = undefined') {{t("暂不设置")}}
    .codex-memory-actions
      button.btn.btn-link.btn-sm(type='button', (click)='openWorkflows()') {{t("任务流程")}}
      button.btn.btn-link.btn-sm(type='button', (click)='openSchedules()') {{t("定时任务{0}", [(scheduledApproval ? t(" · 待审批") : '')])}}
    small.codex-permission-notice(*ngIf='claudeCodeMode') {{t("Claude Code 工具使用终端账户权限；补充消息在当前执行结束后处理；token 用量不代表剩余订阅额度。")}}
    small.codex-permission-notice(*ngIf='apiMode && !claudeCodeMode') {{t("API 工具操作使用终端账户权限；追加输入在下一次模型请求时处理。Thinking 可在上方调整，下一回合生效。")}}
    .codex-send-notice.codex-retry-notice(*ngIf='retryState')
      strong(role='status', aria-live='polite') {{t(retryState.rateLimited ? "请求限流，等待后台自动重试" : "等待后台自动重试")}}
      div(aria-live='off') {{retryNotice}}
    .codex-send-notice(*ngIf='sendNotice && !retryState', role='alert') {{t(sendNotice)}}
    button.btn.btn-outline-primary.btn-sm(type='button', *ngIf='goalStatus === "active" && !busy', (click)='continueTask()') {{t("继续当前目标")}}
    .codex-slash-menu(*ngIf='visibleSlashCommands.length && !request && !loading', role='listbox', [attr.aria-label]='t("命令")')
      button.codex-slash-option(type='button', role='option', *ngFor='let item of visibleSlashCommands; let index = index', [class.codex-slash-active]='slashSelection === index', [attr.aria-selected]='slashSelection === index', (click)='runSlashCommand(item.command)')
        strong {{item.command}}
        span {{t(item.description)}}
    .codex-model-picker(*ngIf='modelPickerOpen')
      .codex-model-heading
        strong {{pendingModel ? t("选择推理强度（Thinking level）") : t("选择模型")}}
        button.btn.btn-link.btn-sm(type='button', (click)='openModelPicker()', [disabled]='modelLoading || modelSaving', [attr.aria-label]='t("刷新模型列表")') {{t("刷新")}}
        button.btn.btn-link.btn-sm(type='button', (click)='modelPickerOpen = false', [attr.aria-label]='t("关闭模型选择")') ×
      small(*ngIf='modelLoading') {{t("正在读取模型…")}}
      small.codex-model-error(*ngIf='modelError') {{t(modelError)}}
      small(*ngIf='!modelLoading && !pendingModel') {{t("当前：{0} · {1}", [(settings.model || t("Codex 默认")), (settings.reasoningEffort || t("默认推理强度"))])}}
      .codex-model-manual(*ngIf='apiMode && !pendingModel')
        input.form-control.form-control-sm([(ngModel)]='apiModelDraft', [attr.placeholder]='t("手动输入模型 ID")', [attr.aria-label]='claudeCodeMode ? t("手动输入模型 ID") : t("手动输入 API 模型 ID")', [disabled]='modelSaving')
        button.btn.btn-outline-secondary.btn-sm(type='button', (click)='selectModel(apiModelDraft)', [disabled]='modelLoading || modelSaving || !apiModelDraft.trim()') {{t("应用")}}
      small(*ngIf='!modelLoading && !pendingModel && !modelError && !models.length') {{t("未获取到可用模型，请手动填写模型 ID。")}}
      .codex-model-list(*ngIf='!modelLoading && !pendingModel')
        button.codex-model-option(type='button', *ngIf='defaultModel', [class.codex-model-selected]='settings.model === defaultModel.model', [disabled]='modelSaving || permissionsSaving', (click)='selectModel("")') {{claudeCodeMode ? t("当前 Claude Code 配置") : apiMode ? t("当前 API 配置") : t("当前 Codex 默认")}}（{{defaultModel.model}}）
        button.codex-model-option(type='button', *ngFor='let model of otherModels', [class.codex-model-selected]='settings.model === model.model', [disabled]='modelSaving || permissionsSaving', [attr.title]='model.description || model.model', (click)='selectModel(model.model)')
          span {{model.displayName || model.model}}
          small {{model.model}}
      small(*ngIf='pendingModel') {{pendingModel.displayName || pendingModel.model}}
      .codex-model-list(*ngIf='pendingModel')
        button.codex-model-option(type='button', *ngIf='apiMode', [class.codex-model-selected]='settings.model === pendingModel.model && !settings.reasoningEffort', [disabled]='modelSaving || permissionsSaving', (click)='chooseModel(pendingModel.model, "")') {{t("服务商默认")}}
        button.codex-model-option(type='button', *ngFor='let option of pendingModel.supportedReasoningEfforts', [class.codex-model-selected]='settings.model === pendingModel.model && settings.reasoningEffort === option.reasoningEffort', [disabled]='modelSaving || permissionsSaving', [attr.title]='option.description', (click)='chooseModel(pendingModel.model, option.reasoningEffort)')
          span {{option.reasoningEffort}}
          small {{option.reasoningEffort === pendingModel.defaultReasoningEffort ? t("模型默认") : option.description}}
      label(*ngIf='pendingModel && apiMode', [attr.for]='"api-effort-draft-" + threadId') {{t("推理强度（可选）")}}
      .codex-model-manual(*ngIf='pendingModel && apiMode')
        input.form-control.form-control-sm([id]='"api-effort-draft-" + threadId', [(ngModel)]='apiEffortDraft', [attr.placeholder]='t("服务商默认")', [attr.aria-label]='t("Thinking 推理强度")', [disabled]='modelSaving', maxlength='100')
        button.btn.btn-outline-secondary.btn-sm(type='button', (click)='chooseModel(pendingModel.model, apiEffortDraft.trim(), true)', [disabled]='modelSaving || permissionsSaving') {{t("应用")}}
      button.btn.btn-link.btn-sm(type='button', *ngIf='pendingModel', (click)='pendingModel = undefined', [disabled]='modelSaving') {{t("返回模型列表")}}
    textarea.form-control(dir='auto', rows='3', [ngModel]='prompt', (ngModelChange)='onPromptChanged($event)', [disabled]='!!request', [attr.placeholder]='t("描述任务或输入 / 选择命令")', (keydown)='onPromptKeydown($event)')
    .codex-compose-toolbar
      .codex-permissions([attr.aria-label]='t("执行权限")')
        .codex-permission-field
          label(for='codex-sandbox') {{apiMode ? t("工具") : t("文件")}}
          select#codex-sandbox.form-control.form-control-sm([ngModel]='settings.sandbox', (ngModelChange)='setSandbox($event)', [disabled]='permissionsSaving || loading', [attr.title]='t("文件访问权限；下一回合生效")')
            option(value='read-only') {{t("只读")}}
            option(value='workspace-write') {{apiMode ? t("终端操作") : t("工作区可写")}}
            option(value='danger-full-access') {{apiMode ? t("终端操作（无隔离）") : t("完全访问")}}
        .codex-permission-field
          label(for='codex-approval') {{t("审批")}}
          select#codex-approval.form-control.form-control-sm([ngModel]='settings.approvalPolicy', (ngModelChange)='setApprovalPolicy($event)', [disabled]='permissionsSaving || loading', [attr.title]='t("操作审批策略；下一回合生效")')
            option(value='on-request') {{t("按需")}}
            option(value='untrusted') {{apiMode ? t("操作时询问") : t("不可信时")}}
            option(value='never') {{t("不询问")}}
      .codex-compose-actions
        button.btn.btn-outline-danger.btn-sm(type='button', (click)='stop()', *ngIf='busy', [disabled]='!turnId') {{t("停止")}}
        button.btn.btn-primary.btn-sm(type='button', (click)='send()', [disabled]='!prompt.trim() || loading || !!request || !!retryState') {{busy ? t("追加指令") : t("发送")}}
    small.codex-permission-notice(*ngIf='permissionNotice') {{t(permissionNotice)}}
