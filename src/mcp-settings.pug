.mcp-settings
  .mcp-heading
    label.mcp-check(for='mcp-enabled')
      input#mcp-enabled(type='checkbox', [checked]='state.enabled', [disabled]='busy', (change)='toggle($any($event.target).checked, $any($event.target))')
      strong {{t("启用本机 MCP 只读服务")}}
    button.btn.btn-outline-secondary(type='button', (click)='refresh()', [disabled]='busy') {{t("刷新")}}
  p.mcp-muted {{t("让外部 AI 客户端读取你明确授权的 Tabby 终端；无需配置侧栏模型。当前预览不提供终端输入或命令执行。")}}
  p.mcp-status(role='status', aria-live='polite') {{state.running ? t("服务已启动") : state.enabled ? t("服务未启动") : t("服务已关闭")}}
    code(*ngIf='state.endpoint') {{state.endpoint}}
  p.mcp-notice(role='alert', *ngIf='state.error') {{t(state.error)}}
  p.mcp-notice(role='status', aria-live='polite', *ngIf='notice') {{t(notice)}}
  .mcp-port(*ngIf='!state.enabled')
    label(for='mcp-port') {{t("本机端口（0 表示首次自动选择）")}}
    input#mcp-port.form-control(type='number', min='0', max='65535', [(ngModel)]='port', [disabled]='busy')
    button.btn.btn-outline-secondary(type='button', (click)='setPort()', [disabled]='busy') {{t("保存端口")}}
  ng-container(*ngIf='state.running')
    .mcp-add
      label(for='mcp-name') {{t("客户端名称")}}
      input#mcp-name.form-control(type='text', maxlength='80', autocomplete='off', [(ngModel)]='name', [disabled]='busy', (keydown.enter)='add()')
      button.btn.btn-primary(type='button', (click)='add()', [disabled]='busy || !name.trim()') {{t("添加客户端")}}
    p.mcp-muted(*ngIf='!state.clients.length') {{t("添加客户端后，复制配置并选择可读取的终端。新客户端默认没有终端权限。")}}
    .mcp-client(*ngIf='state.clients.length')
      label(for='mcp-client') {{t("管理客户端")}}
      select#mcp-client.form-control([ngModel]='selectedId', (ngModelChange)='select($event)', [disabled]='busy')
        option(*ngFor='let client of state.clients', [value]='client.id') {{client.name}}
    ng-container(*ngIf='selected')
      p.mcp-muted {{t("最近请求")}}: {{selected.lastSeen || t("尚未收到客户端请求")}} · {{t("最近请求不代表持续在线。")}}
      fieldset.mcp-targets([disabled]='busy')
        legend {{t("允许读取的终端")}}
        p.mcp-muted {{t("勾选即允许该客户端读取整个终端的输出，可能包含敏感信息。取消勾选立即撤销并中止等待；关闭、重连或重启后需要重新授权。")}}
        p.mcp-muted {{t("窗口与终端标题用于识别目标；嵌套 SSH 或容器身份不会自动验证。")}}
        p.mcp-muted(*ngIf='!state.targets.length') {{t("请先打开一个终端。")}}
        label.mcp-check(*ngFor='let target of state.targets')
          input(type='checkbox', [checked]='selected.targets.includes(target.id)', (change)='scope(target.id, $any($event.target).checked, $any($event.target))')
          span {{target.title}} · {{t("窗口")}} {{target.window}}
      .mcp-actions
        button.btn.btn-outline-secondary(type='button', (click)='rotate()', [disabled]='busy') {{t("轮换凭据并生成配置")}}
        button.btn.btn-outline-danger(type='button', (click)='revoke()', [disabled]='busy') {{t("撤销客户端")}}
      .mcp-config(*ngIf='configuration')
        label(for='mcp-kind') {{t("客户端配置格式")}}
        select#mcp-kind.form-control([(ngModel)]='kind', [disabled]='busy')
          option(value='codex') Codex CLI · config.toml
          option(value='cursor') Cursor · mcp.json
          option(value='claude') Claude Code · JSON
        p.mcp-muted {{t("凭据仅在此处临时显示。请将片段手动合并到所选客户端的个人配置；保留其他条目，名称冲突时使用新名称。插件不会改写客户端文件。")}}
        textarea#mcp-configuration.form-control(readonly, rows='8', [value]='configuration', [attr.aria-label]='t("含凭据的客户端配置")', spellcheck='false')
        .mcp-actions
          button.btn.btn-primary(type='button', (click)='copy()', [disabled]='busy') {{t("复制配置")}}
          button.btn.btn-outline-secondary(type='button', (click)='token = ""', [disabled]='busy') {{t("隐藏凭据")}}
      p.mcp-muted(*ngIf='!configuration') {{t("如需再次复制配置，请轮换凭据；旧凭据会立即失效。")}}
